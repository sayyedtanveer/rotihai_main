{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist/public",
  "routes": [
    { "src": "/assets/(.*)", "dest": "/assets/$1" },
    { "src": "/(.*)\\.(js|css|png|jpg|svg|ico|xml|txt|webmanifest|json)", "dest": "/$1.$2" },
    { "src": "/.*", "dest": "/index.html" }
  ]
}
